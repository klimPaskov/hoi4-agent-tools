    {
      "id": "chaos_redux.probability.adapter-and-steps",
      "surface": "probability",
      "corpus": "chaos_redux",
      "problem": 7,
      "title": "A sweep of a decision uses the decision adapter and the requested 5 steps",
      "evidence": "death_consume_another_island in common/decisions/010_death_decisions.txt:22 is a decision with ai_will_do and no mission timeout. Live test: decision_ai_will_do came back as mission_ai_will_do with 1 sweep point instead of 5.",
      "tool": "hoi4.probability_analyze",
      "arguments": {
        "analysis": "sweep",
        "adapter": "decision_ai_will_do",
        "source": "common/decisions/010_death_decisions.txt",
        "candidatePool": ["death_consume_another_island"],
        "scenarioSet": [
          {
            "actor": "GER",
            "state": {
              "variable.death_souls": 10
            }
          }
        ],
        "sweep": {
          "paths": ["variable.death_souls"],
          "steps": 5
        }
      },
      "expect": [
        {
          "path": "data.adapterId",
          "equals": "decision_ai_will_do"
        },
        {
          "path": "data.sweepPoints",
          "equals": 5
        }
      ]
    },
