{
  "about": "Cases on Chaos Redux, from the 50 live calls of 2026-11-01 (plan problems 1 to 14). Run locally only: the mod's files never leave the machine, only the expected identifiers are recorded here.",
  "cases": [
    {
      "id": "chaos_redux.mod_index.cold-overview",
      "surface": "mod_index",
      "corpus": "chaos_redux",
      "problem": 13,
      "title": "The first overview of Chaos Redux answers within 2 seconds",
      "evidence": "Live test: 13 to 15 s cold. Target from the plan: at most 2 s.",
      "tool": "hoi4.mod_index",
      "arguments": {
        "mode": "overview"
      },
      "timing": "cold",
      "budgetMs": 2000,
      "expect": [
        {
          "path": "data.complete",
          "equals": true
        }
      ]
    },
    {
      "id": "chaos_redux.source_lookup.cold-first",
      "surface": "source_lookup",
      "corpus": "chaos_redux",
      "problem": 13,
      "title": "The first source lookup finds the event definition within 3 seconds",
      "evidence": "events/010_death.txt:158 defines chaosx.nr10.20 (read 2026-11-01). Live test: 58.9 s for the first lookup.",
      "tool": "hoi4.source_lookup",
      "arguments": {
        "symbol": "chaosx.nr10.20",
        "kind": "event",
        "maxLines": 5
      },
      "timing": "cold",
      "budgetMs": 3000,
      "expect": [
        {
          "path": "data.definitions[0].path",
          "equals": "mod:events/010_death.txt"
        },
        {
          "path": "data.definitions[0].startLine",
          "equals": 158
        }
      ]
    },
    {
      "id": "chaos_redux.source_lookup.event-caller",
      "surface": "source_lookup",
      "corpus": "chaos_redux",
      "problem": 2,
      "title": "The lookup names the scripted effect that fires chaosx.nr10.20",
      "evidence": "common/scripted_effects/010_death_effects.txt:2572 fires chaosx.nr10.20 inside death_decision_whisper_to_zol_effect (read 2026-11-01).",
      "tool": "hoi4.source_lookup",
      "arguments": {
        "symbol": "chaosx.nr10.20",
        "kind": "event",
        "maxLines": 5
      },
      "timing": "warm",
      "repeat": 10,
      "budgetMs": 50,
      "expect": [
        {
          "path": "data.references[*].from",
          "includes": "death_decision_whisper_to_zol_effect"
        }
      ]
    },
    {
      "id": "chaos_redux.event.upstream-caller",
      "surface": "event",
      "corpus": "chaos_redux",
      "problem": 2,
      "title": "An upstream trace of chaosx.nr10.20 shows its scripted-effect caller",
      "evidence": "Same caller as chaos_redux.source_lookup.event-caller. Live test: 0 callers, and 5,895 events counted as callerless.",
      "tool": "hoi4.event_inspect",
      "arguments": {
        "mode": "trace",
        "selector": {
          "kind": "event",
          "eventId": "chaosx.nr10.20"
        },
        "direction": "upstream"
      },
      "expect": [
        {
          "path": "**",
          "includes": "death_decision_whisper_to_zol_effect"
        }
      ]
    },
    {
      "id": "chaos_redux.event.helpers-resolved",
      "surface": "event",
      "corpus": "chaos_redux",
      "problem": 1,
      "title": "The helpers chaosx.nr9.1 calls resolve to their definitions",
      "evidence": "Live test: 6 helpers defined in common/scripted_effects/009_white_peace_effects.txt marked EVENT_HELPER_UNRESOLVED, and expandHelpers: true changed nothing.",
      "tool": "hoi4.event_inspect",
      "arguments": {
        "mode": "trace",
        "selector": {
          "kind": "event",
          "eventId": "chaosx.nr9.1"
        },
        "direction": "downstream",
        "expandHelpers": true
      },
      "expect": [
        {
          "path": "**",
          "excludes": "EVENT_HELPER_UNRESOLVED"
        },
        {
          "path": "**",
          "excludes": "EVENT_HELPER_UNRESOLVED",
          "artifact": "event-trace"
        }
      ]
    },
    {
      "id": "chaos_redux.event.unknown-event",
      "surface": "event",
      "corpus": "chaos_redux",
      "problem": 3,
      "title": "An unknown event id is an explicit not-found",
