      "arguments": {
        "mode": "trace",
        "selector": {
          "kind": "event",
          "eventId": "chaosx.nr10.20"
        },
        "direction": "downstream"
      },
      "expect": [
        {
          "path": "filesScanned[*]",
          "excludes": "001_communism_spread_on_actions"
