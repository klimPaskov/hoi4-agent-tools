      "tool": "hoi4.event_inspect",
      "arguments": {
        "mode": "trace",
        "selector": "bench_regress.1",
        "direction": "upstream"
      },
      "expect": [
        {
          "path": "status",
          "equals": "ok"
        },
        {
          "path": "**",
          "includes": "bench_regress_fire_effect",
          "note": "The helper caller appears in the inline answer."
