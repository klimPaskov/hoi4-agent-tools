      "tool": "hoi4.script_validate",
      "arguments": {
        "path": "common/scripted_effects/bench_regression_effects.txt"
      },
      "expect": [
        {
          "path": "data.unresolvedCount",
          "equals": 0
        },
        {
          "path": "$text",
          "includes": "scope",
          "note": "A partial check says inline which scope it could not check."
        }
      ]
