{
  "about": "Cases on the project fixtures, run in CI on every platform. The expected answers come from the fixture source itself.",
  "cases": [
    {
      "id": "synthetic.mod_index.cold-overview",
      "surface": "mod_index",
      "corpus": "synthetic",
      "title": "The first overview of the mod answers with its event namespaces",
      "evidence": "fixtures/event/workspace/events/synthetic_alpha_01.txt declares add_namespace = synthetic_alpha.",
      "tool": "hoi4.mod_index",
      "arguments": {
        "mode": "overview"
      },
      "timing": "cold",
      "budgetMs": 2000,
      "expect": [
        {
          "path": "status",
          "equals": "ok"
        },
        {
          "path": "data.complete",
          "equals": true
        }
      ]
    },
    {
      "id": "synthetic.mod_index.next-id",
      "surface": "mod_index",
      "corpus": "synthetic",
      "title": "The next free synthetic_alpha event id follows the highest one",
      "evidence": "synthetic_alpha_01.txt and synthetic_alpha_02.txt define synthetic_alpha.1 to synthetic_alpha.80 with no gaps after 80.",
      "tool": "hoi4.mod_index",
      "arguments": {
        "mode": "next_id",
        "kind": "event",
        "namespace": "synthetic_alpha"
      },
      "timing": "warm",
      "repeat": 5,
      "budgetMs": 50,
      "expect": [
        {
          "path": "data.next.nextId",
          "equals": "synthetic_alpha.81"
        }
      ]
    },
    {
      "id": "synthetic.source_lookup.helper-definition",
      "surface": "source_lookup",
      "corpus": "synthetic",
      "title": "A scripted effect is found at its definition with its event caller",
      "evidence": "synthetic_alpha_outer is defined at common/scripted_effects/synthetic_event_helpers.txt:2 and called at events/synthetic_alpha_01.txt:60.",
      "tool": "hoi4.source_lookup",
      "arguments": {
        "symbol": "synthetic_alpha_outer"
      },
      "timing": "cold",
      "budgetMs": 3000,
      "expect": [
        {
          "path": "status",
          "equals": "ok"
        },
        {
          "path": "data.definitions[0].path",
          "equals": "mod:common/scripted_effects/synthetic_event_helpers.txt"
        },
        {
          "path": "data.definitions[0].startLine",
          "equals": 2
        },
        {
          "path": "data.references[*].path",
          "includes": "mod:events/synthetic_alpha_01.txt"
        }
      ]
    },
    {
      "id": "synthetic.source_lookup.warm",
      "surface": "source_lookup",
      "corpus": "synthetic",
      "title": "A repeated lookup answers from the warm index",
      "evidence": "Same symbol as synthetic.source_lookup.helper-definition.",
      "tool": "hoi4.source_lookup",
      "arguments": {
        "symbol": "synthetic_alpha_outer"
      },
      "timing": "warm",
      "repeat": 10,
      "budgetMs": 50,
      "expect": [
        {
          "path": "data.definitionCount",
          "equals": 1
        }
      ]
    },
    {
      "id": "synthetic.source_lookup.unknown-symbol",
      "surface": "source_lookup",
      "corpus": "synthetic",
      "problem": 3,
      "title": "An unknown symbol is an explicit not-found, not ok with nothing",
      "evidence": "No file of the fixture or stand-in game mentions synthetic_no_such_symbol.",
      "tool": "hoi4.source_lookup",
      "arguments": {
        "symbol": "synthetic_no_such_symbol"
      },
      "expect": [
        {
          "path": "status",
          "equals": "error"
        },
        {
          "path": "code",
          "equals": "SYMBOL_NOT_FOUND"
        },
        {
          "path": "$text",
          "includes": "synthetic_no_such_symbol"
        }
      ]
    },
    {
      "id": "synthetic.source_lookup.description-example",
      "surface": "source_lookup",
      "corpus": "synthetic",
      "problem": 9,
      "title": "The example call in the tool description works",
      "evidence": "The tools/list description shows {\"symbol\":\"my_scripted_effect\"}; an agent copying it on a mod without that symbol must get a clear not-found, not an argument error.",
      "tool": "hoi4.source_lookup",
      "arguments": {
        "symbol": "my_scripted_effect"
      },
      "expect": [
        {
          "path": "code",
          "matches": "_NOT_FOUND$"
        },
        {
          "path": "$text",
          "includes": "my_scripted_effect"
        }
      ]
    },
    {
      "id": "synthetic.validation.supported-effect",
      "surface": "validation",
      "corpus": "synthetic",
      "title": "A documented effect in its scope is valid and fully checked",
      "evidence": "The stand-in effects documentation lists add_political_power for COUNTRY.",
      "tool": "hoi4.script_validate",
      "arguments": {
        "source": "add_political_power = 10",
        "kind": "effect",
        "scope": "country"
      },
      "timing": "warm",
      "repeat": 5,
      "budgetMs": 50,
      "expect": [
        {
          "path": "data.valid",
          "equals": true
        },
        {
          "path": "code",
          "equals": "SCRIPT_CHECKED"
        }
      ]
    },
    {
      "id": "synthetic.validation.wrong-scope",
      "surface": "validation",
      "corpus": "synthetic",
      "title": "A country effect in state scope is a scope error",
      "evidence": "The stand-in documentation supports add_political_power in COUNTRY only.",
      "tool": "hoi4.script_validate",
      "arguments": {
        "source": "add_political_power = 10",
        "kind": "effect",
        "scope": "state"
      },
      "expect": [
        {
          "path": "data.valid",
          "equals": false
        },
        {
          "path": "data.findings[*].code",
          "includes": "SCRIPT_COMMAND_WRONG_SCOPE"
        }
      ]
    },
    {
      "id": "synthetic.validation.typo",
      "surface": "validation",
      "corpus": "synthetic",
      "title": "A misspelled effect names the documented one",
      "evidence": "add_politcal_power is one letter from add_political_power.",
      "tool": "hoi4.script_validate",
      "arguments": {
        "source": "add_politcal_power = 10",
        "kind": "effect",
        "scope": "country"
      },
      "expect": [
        {
          "path": "data.findings[0].suggestions",
          "includes": "add_political_power"
        }
