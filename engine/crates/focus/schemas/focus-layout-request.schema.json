{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/klimPaskov/hoi4-agent-tools/blob/main/engine/crates/focus/schemas/focus-layout-request.schema.json",
  "title": "hoi4-focus-layout-request/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation", "focuses"],
  "properties": {
    "schema": { "const": "hoi4-focus-layout-request/1" },
    "operation": { "enum": ["layout", "insert"] },
    "treeId": { "type": "string" },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeSpacing": { "type": "integer", "minimum": 1, "maximum": 64, "default": 2 },
        "laneSpacing": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 2 }
      }
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "default": 0 },
          "minimumX": { "$ref": "#/$defs/coordinate" },
          "maximumX": { "$ref": "#/$defs/coordinate" }
        }
      }
    },
    "focuses": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "prerequisites": {
            "description": "AND of OR groups",
            "type": "array",
            "items": { "type": "array", "items": { "type": "string" } }
          },
          "mutuallyExclusive": { "type": "array", "items": { "type": "string" } },
          "laneId": { "type": "string", "default": "default" },
          "position": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "x", "y"],
                "properties": {
                  "mode": { "const": "fixed" },
                  "x": { "$ref": "#/$defs/coordinate" },
                  "y": { "$ref": "#/$defs/coordinate" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "x", "y", "relativeTo"],
                "properties": {
                  "mode": { "const": "relative" },
                  "x": { "$ref": "#/$defs/coordinate" },
                  "y": { "$ref": "#/$defs/coordinate" },
                  "relativeTo": { "type": "string" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode"],
                "properties": {
                  "mode": { "const": "auto" },
                  "preferredX": { "$ref": "#/$defs/coordinate" },
                  "preferredY": { "$ref": "#/$defs/coordinate" }
                }
              }
            ]
          },
          "pinned": { "type": "boolean", "default": false }
        }
      }
    },
    "insert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focusIds"],
      "properties": {
        "focusIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "anchorId": { "type": "string" },
        "preferSide": { "enum": ["left", "right", "either"], "default": "either" },
        "allowShift": { "type": "boolean", "default": false }
      }
    }
  },
  "$defs": {
    "coordinate": { "type": "integer", "minimum": -100000, "maximum": 100000 }
  }
}
