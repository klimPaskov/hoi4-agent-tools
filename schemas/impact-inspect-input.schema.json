{
  "$id": "https://github.com/klimPaskov/hoi4-agent-tools/blob/v3.4.0/schemas/impact-inspect-input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspaceId": {
      "$ref": "#/$defs/__schema0"
    },
    "symbols": {
      "$ref": "#/$defs/__schema1"
    },
    "changedFiles": {
      "$ref": "#/$defs/__schema3"
    },
    "scenarioSuites": {
      "$ref": "#/$defs/__schema5"
    },
    "proposedSources": {
      "$ref": "#/$defs/__schema8"
    },
    "maxNodes": {
      "$ref": "#/$defs/__schema10"
    },
    "maxEdges": {
      "$ref": "#/$defs/__schema11"
    },
    "maxDepth": {
      "$ref": "#/$defs/__schema12"
    },
    "expectedRevision": {
      "$ref": "#/$defs/__schema13"
    },
    "refresh": {
      "$ref": "#/$defs/__schema14"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "default": "current",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "__schema1": {
      "default": [],
      "maxItems": 64,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "focus_tree",
            "focus",
            "continuous_focus_palette",
            "continuous_focus",
            "decision",
            "decision_category",
            "event",
            "idea",
            "leader",
            "formable",
            "scripted_effect",
            "scripted_trigger",
            "script_constant",
            "mtth_variable",
            "ai_strategy",
            "ai_strategy_plan",
            "sprite",
            "texture",
            "gui_element",
            "scripted_gui",
            "technology",
            "technology_folder",
            "technology_category",
            "technology_tag",
            "equipment",
            "equipment_module",
            "sub_unit",
            "unit_category",
            "building",
            "ability",
            "combat_tactic",
            "doctrine_folder",
            "grand_doctrine",
            "doctrine_track",
            "subdoctrine",
            "localisation",
            "variable",
            "flag",
            "event_target",
            "state",
            "province",
            "province_color",
            "strategic_region",
            "adjacency",
            "supply_node",
            "railway"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "default": [],
      "maxItems": 64,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "__schema4": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "__schema5": {
      "default": [],
      "maxItems": 32,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema6"
      }
    },
    "__schema6": {
      "$ref": "#/$defs/__schema7"
    },
    "__schema7": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "__schema8": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema9"
      }
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "relativePath": {
          "$ref": "#/$defs/__schema7"
        },
        "content": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 8388608
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "relativePath",
        "content"
      ],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50000
    },
    "__schema11": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "__schema12": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "__schema13": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema14": {
      "default": false,
      "type": "boolean"
    }
  }
}
