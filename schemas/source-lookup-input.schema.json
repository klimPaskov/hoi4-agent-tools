{
  "$id": "https://github.com/klimPaskov/hoi4-agent-tools/blob/v3.8.1/schemas/source-lookup-input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspaceId": {
      "$ref": "#/$defs/__schema0"
    },
    "symbol": {
      "$ref": "#/$defs/__schema1"
    },
    "path": {
      "$ref": "#/$defs/__schema2"
    },
    "line": {
      "$ref": "#/$defs/__schema3"
    },
    "column": {
      "$ref": "#/$defs/__schema4"
    },
    "kind": {
      "$ref": "#/$defs/__schema5"
    },
    "includeReferences": {
      "$ref": "#/$defs/__schema6"
    },
    "maxDefinitions": {
      "$ref": "#/$defs/__schema7"
    },
    "maxReferences": {
      "$ref": "#/$defs/__schema8"
    },
    "maxLines": {
      "$ref": "#/$defs/__schema9"
    },
    "keyPath": {
      "$ref": "#/$defs/__schema10"
    },
    "view": {
      "$ref": "#/$defs/__schema12"
    },
    "maxChildren": {
      "$ref": "#/$defs/__schema13"
    },
    "childOffset": {
      "$ref": "#/$defs/__schema14"
    },
    "fromLine": {
      "$ref": "#/$defs/__schema15"
    },
    "fromColumn": {
      "$ref": "#/$defs/__schema16"
    },
    "expectedRevision": {
      "$ref": "#/$defs/__schema17"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "default": "current",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "__schema3": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema4": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema5": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "__schema6": {
      "default": true,
      "type": "boolean"
    },
    "__schema7": {
      "default": 3,
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "__schema8": {
      "default": 10,
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "__schema9": {
      "default": 30,
      "type": "integer",
      "minimum": 1,
      "maximum": 80
    },
    "__schema10": {
      "maxItems": 24,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema11"
      }
    },
    "__schema11": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "occurrence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          },
          "required": [
            "index"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema12": {
      "default": "source",
      "type": "string",
      "enum": [
        "source",
        "structure"
      ]
    },
    "__schema13": {
      "default": 20,
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "__schema14": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "__schema15": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema16": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema17": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
