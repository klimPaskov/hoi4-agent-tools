{
  "$id": "https://github.com/klimPaskov/hoi4-agent-tools/blob/v3.7.0/schemas/source-lookup-input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspaceId": {
      "default": "current",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "includeReferences": {
      "default": true,
      "type": "boolean"
    },
    "maxDefinitions": {
      "default": 3,
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "maxReferences": {
      "default": 10,
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "maxLines": {
      "default": 30,
      "type": "integer",
      "minimum": 1,
      "maximum": 80
    },
    "keyPath": {
      "maxItems": 24,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "view": {
      "default": "source",
      "type": "string",
      "enum": [
        "source",
        "structure"
      ]
    },
    "maxChildren": {
      "default": 20,
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "childOffset": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "fromLine": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "fromColumn": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expectedRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "symbol"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "occurrence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          },
          "required": [
            "index"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
