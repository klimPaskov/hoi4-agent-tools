{
  "$id": "https://github.com/klimPaskov/hoi4-agent-tools/blob/v4.0.0/schemas/script-validate-input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspaceId": {
      "$ref": "#/$defs/__schema0"
    },
    "source": {
      "$ref": "#/$defs/__schema1"
    },
    "path": {
      "$ref": "#/$defs/__schema2"
    },
    "kind": {
      "$ref": "#/$defs/__schema3"
    },
    "scope": {
      "$ref": "#/$defs/__schema4"
    },
    "documentation": {
      "$ref": "#/$defs/__schema6"
    },
    "bindings": {
      "$ref": "#/$defs/__schema7"
    },
    "limit": {
      "$ref": "#/$defs/__schema9"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "default": "current",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64000
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "__schema3": {
      "type": "string",
      "enum": [
        "effect",
        "trigger"
      ]
    },
    "__schema4": {
      "$ref": "#/$defs/__schema5"
    },
    "__schema5": {
      "type": "string",
      "enum": [
        "country",
        "state",
        "character",
        "combatant",
        "ace",
        "strategic_region",
        "operation",
        "industrial_org",
        "purchase_contract",
        "raid_instance",
        "special_project",
        "faction"
      ]
    },
    "__schema6": {
      "default": "game_doc",
      "type": "string",
      "enum": [
        "game_doc",
        "script_doc"
      ]
    },
    "__schema7": {
      "default": [],
      "maxItems": 16,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema8"
      }
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scope": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "name",
        "scope"
      ],
      "additionalProperties": false
    },
    "__schema9": {
      "default": 12,
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    }
  }
}
