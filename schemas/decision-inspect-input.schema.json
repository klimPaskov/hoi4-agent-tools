{
  "$id": "https://github.com/klimPaskov/hoi4-agent-tools/blob/v3.5.1/schemas/decision-inspect-input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspaceId": {
      "$ref": "#/$defs/__schema0"
    },
    "mode": {
      "$ref": "#/$defs/__schema1"
    },
    "id": {
      "$ref": "#/$defs/__schema2"
    },
    "scenarios": {
      "$ref": "#/$defs/__schema3"
    },
    "proposedSources": {
      "$ref": "#/$defs/__schema15"
    },
    "expectedRevision": {
      "$ref": "#/$defs/__schema17"
    },
    "refresh": {
      "$ref": "#/$defs/__schema18"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "default": "current",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "__schema1": {
      "default": "inventory",
      "type": "string",
      "enum": [
        "inventory",
        "inspect",
        "compare"
      ]
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "__schema3": {
      "default": [],
      "maxItems": 64,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "actor": {
          "type": "string",
          "maxLength": 256
        },
        "date": {
          "type": "string",
          "maxLength": 64
        },
        "controls": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema5"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema6"
          }
        },
        "state": {
          "$ref": "#/$defs/__schema7"
        },
        "flags": {
          "maxItems": 10000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema11"
          }
        },
        "eventTargets": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 512
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 512
          }
        },
        "scopes": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema12"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema13"
          }
        },
        "candidateOverrides": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 512
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "closedFlags": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "state"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,8}$"
    },
    "__schema6": {
      "type": "string",
      "pattern": "^[A-Z0-9]{3}$"
    },
    "__schema7": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema8"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema9"
      }
    },
    "__schema8": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "__schema9": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema10"
        },
        {
          "maxItems": 10000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema10"
          }
        }
      ]
    },
    "__schema10": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4096
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema11": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "__schema12": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "__schema13": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "type": {
          "type": "string",
          "enum": [
            "country",
            "state",
            "character",
            "unit_leader",
            "operative",
            "strategic_region",
            "province",
            "unknown"
          ]
        },
        "actor": {
          "type": "string",
          "maxLength": 256
        },
        "state": {
          "$ref": "#/$defs/__schema7"
        },
        "flags": {
          "maxItems": 10000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema14"
          }
        },
        "eventTargets": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 512
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 512
          }
        },
        "weight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "maxLength": 1024
            }
          ]
        }
      },
      "required": [
        "id",
        "state"
      ],
      "additionalProperties": false
    },
    "__schema14": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "__schema15": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema16"
      }
    },
    "__schema16": {
      "type": "object",
      "properties": {
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "content": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 8388608
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "relativePath",
        "content"
      ],
      "additionalProperties": false
    },
    "__schema17": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema18": {
      "default": false,
      "type": "boolean"
    }
  }
}
