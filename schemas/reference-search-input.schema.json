{
  "$id": "https://github.com/klimPaskov/hoi4-agent-tools/blob/v3.5.0/schemas/reference-search-input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspaceId": {
      "default": "current",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "query": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "sources": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "limit": {
      "default": 6,
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    }
  },
  "required": [
    "query"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "enum": [
        "game_doc",
        "wiki",
        "script_doc"
      ]
    }
  }
}
