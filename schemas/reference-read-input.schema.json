{
  "$id": "https://github.com/klimPaskov/hoi4-agent-tools/blob/v3.5.0/schemas/reference-read-input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspaceId": {
      "default": "current",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "startLine": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "startColumn": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxLines": {
      "default": 40,
      "type": "integer",
      "minimum": 1,
      "maximum": 80
    }
  },
  "required": [
    "id",
    "revision"
  ],
  "additionalProperties": false
}
