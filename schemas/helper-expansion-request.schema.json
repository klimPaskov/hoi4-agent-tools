{
  "$id": "https://github.com/klimPaskov/hoi4-agent-tools/blob/v3.4.2/schemas/helper-expansion-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rootIds": {
      "minItems": 1,
      "maxItems": 2000,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "maxDepth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "maxRecords": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
    },
    "maxWork": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "continuationUri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^hoi4-agent:\\/\\/"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  }
}
