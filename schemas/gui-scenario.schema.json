{
  "$id": "https://github.com/klimPaskov/hoi4-agent-tools/blob/v3.8.1/schemas/gui-scenario.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "tooltip": {
      "$ref": "#/$defs/__schema1"
    },
    "description": {
      "$ref": "#/$defs/__schema7"
    },
    "date": {
      "$ref": "#/$defs/__schema8"
    },
    "controls": {
      "$ref": "#/$defs/__schema9"
    },
    "resolution": {
      "$ref": "#/$defs/__schema12"
    },
    "uiScale": {
      "$ref": "#/$defs/__schema15"
    },
    "state": {
      "$ref": "#/$defs/__schema17"
    },
    "language": {
      "$ref": "#/$defs/__schema19"
    },
    "animationTimeSeconds": {
      "$ref": "#/$defs/__schema20"
    },
    "visibleTimeSeconds": {
      "$ref": "#/$defs/__schema21"
    },
    "country": {
      "$ref": "#/$defs/__schema22"
    },
    "stateValues": {
      "$ref": "#/$defs/__schema24"
    },
    "scopes": {
      "$ref": "#/$defs/__schema25"
    },
    "conditionResults": {
      "$ref": "#/$defs/__schema28"
    },
    "variables": {
      "$ref": "#/$defs/__schema30"
    },
    "flags": {
      "$ref": "#/$defs/__schema31"
    },
    "lists": {
      "$ref": "#/$defs/__schema32"
    },
    "localisation": {
      "$ref": "#/$defs/__schema33"
    },
    "values": {
      "$ref": "#/$defs/__schema34"
    },
    "scriptedGui": {
      "$ref": "#/$defs/__schema35"
    },
    "visibility": {
      "$ref": "#/$defs/__schema36"
    },
    "elementStates": {
      "$ref": "#/$defs/__schema37"
    },
    "selectedFrames": {
      "$ref": "#/$defs/__schema38"
    },
    "scrollOffsets": {
      "$ref": "#/$defs/__schema39"
    },
    "guiCosts": {
      "$ref": "#/$defs/__schema40"
    },
    "scriptCosts": {
      "$ref": "#/$defs/__schema41"
    },
    "expectations": {
      "$ref": "#/$defs/__schema42"
    }
  },
  "required": [
    "id"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/$defs/__schema2"
        },
        "x": {
          "$ref": "#/$defs/__schema3"
        },
        "y": {
          "$ref": "#/$defs/__schema4"
        },
        "width": {
          "$ref": "#/$defs/__schema5"
        },
        "padding": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": [
        "target",
        "x",
        "y",
        "width",
        "padding"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "__schema3": {
      "type": "number",
      "minimum": 0
    },
    "__schema4": {
      "type": "number",
      "minimum": 0
    },
    "__schema5": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 16384
    },
    "__schema6": {
      "type": "number",
      "minimum": 0,
      "maximum": 8192,
      "description": "Caller-declared inset on each side, in viewport pixels; no native padding is inferred."
    },
    "__schema7": {
      "type": "string",
      "maxLength": 500
    },
    "__schema8": {
      "type": "string",
      "maxLength": 16
    },
    "__schema9": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema10"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema11"
      }
    },
    "__schema10": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,8}$"
    },
    "__schema11": {
      "type": "string",
      "pattern": "^[A-Z0-9]{3}$"
    },
    "__schema12": {
      "default": {
        "width": 1920,
        "height": 1080
      },
      "type": "object",
      "properties": {
        "width": {
          "$ref": "#/$defs/__schema13"
        },
        "height": {
          "$ref": "#/$defs/__schema14"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "__schema13": {
      "type": "integer",
      "minimum": 320,
      "maximum": 16384
    },
    "__schema14": {
      "type": "integer",
      "minimum": 200,
      "maximum": 16384
    },
    "__schema15": {
      "default": 1,
      "description": "In-game UI scale. Use 1 for the normal 1920x1080 layout; this changes layout geometry and is not an output-image zoom.",
      "$ref": "#/$defs/__schema16"
    },
    "__schema16": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 4
    },
    "__schema17": {
      "default": "normal",
      "$ref": "#/$defs/__schema18"
    },
    "__schema18": {
      "type": "string",
      "enum": [
        "normal",
        "hover",
        "selected",
        "locked",
        "disabled",
        "warning",
        "active",
        "completed",
        "empty-list",
        "full-list",
        "minimum-value",
        "maximum-value",
        "long-text",
        "missing-localisation"
      ]
    },
    "__schema19": {
      "default": "l_english",
      "type": "string",
      "pattern": "^l_[a-z_]+$"
    },
    "__schema20": {
      "default": 0,
      "type": "number",
      "minimum": 0,
      "maximum": 86400
    },
    "__schema21": {
      "type": "number",
      "minimum": 0,
      "maximum": 86400
    },
    "__schema22": {
      "$ref": "#/$defs/__schema23"
    },
    "__schema23": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 16384
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "__schema24": {
      "$ref": "#/$defs/__schema23"
    },
    "__schema25": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 256
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "type": {
            "type": "string",
            "enum": [
              "country",
              "state",
              "character",
              "unit_leader",
              "operative",
              "strategic_region",
              "province",
              "unknown"
            ]
          },
          "actor": {
            "type": "string",
            "maxLength": 256
          },
          "state": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "$ref": "#/$defs/__schema26"
                },
                {
                  "maxItems": 10000,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema26"
                  }
                }
              ]
            }
          },
          "flags": {
            "maxItems": 10000,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema27"
            }
          },
          "eventTargets": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 256
            }
          },
          "weight": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "maxLength": 256
              }
            ]
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "__schema26": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 16384
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema27": {
      "type": "string",
      "maxLength": 256
    },
    "__schema28": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema29"
      }
    },
    "__schema29": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        },
        "sourcePath": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "true",
            "false",
            "unresolved"
          ]
        },
        "localisationKey": {
          "type": "string"
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "token",
        "sourcePath",
        "state",
        "unresolved"
      ],
      "additionalProperties": false
    },
    "__schema30": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "__schema31": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "__schema32": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "maxItems": 10000,
        "type": "array",
        "items": {
          "$ref": "#/$defs/__schema23"
        }
      }
    },
    "__schema33": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "__schema34": {
      "default": {},
      "$ref": "#/$defs/__schema23"
    },
    "__schema35": {
      "default": {},
      "$ref": "#/$defs/__schema23"
    },
    "__schema36": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "__schema37": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema18"
      }
    },
    "__schema38": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "__schema39": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "__schema40": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "__schema41": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "__schema42": {
      "default": {
        "visible": [],
        "hidden": [],
        "containedBy": {},
        "centeredOn": {}
      },
      "type": "object",
      "properties": {
        "visible": {
          "default": [],
          "maxItems": 10000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "hidden": {
          "default": [],
          "maxItems": 10000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "containedBy": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema2"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "centeredOn": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema2"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema2"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
